#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Conventional commits: type(scope?): subject
commit_regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?: .{1,80}$'

if ! grep -Eq "$commit_regex" "$1"; then
  echo "✗ Invalid commit message."
  echo "  Expected: <type>(<scope>): <subject>"
  echo "  Example:  feat(booking): add livestream toggle"
  exit 1
fi
