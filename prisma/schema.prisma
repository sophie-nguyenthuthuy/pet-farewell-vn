// Pet Farewell VN — data model
// Premium pet cremation, memorial, and grief-support service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  COUNSELOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  name          String
  hashedPassword String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("vi")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pets       Pet[]
  bookings   Booking[]
  memorials  Memorial[]
  sessions   Session[]
  accounts   Account[]
  counselorBookings CounselingSession[] @relation("CounselorOnSession")
  clientCounseling  CounselingSession[] @relation("ClientOnSession")

  @@index([role])
}

// NextAuth-compatible session/account tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Pets
// ---------------------------------------------------------------------------

enum PetSpecies {
  DOG
  CAT
  RABBIT
  BIRD
  HAMSTER
  REPTILE
  OTHER
}

enum PetSizeBand {
  XS  // < 5 kg
  S   // 5–10 kg
  M   // 10–20 kg
  L   // 20–35 kg
  XL  // 35+ kg
}

model Pet {
  id          String      @id @default(cuid())
  ownerId     String
  name        String
  species     PetSpecies
  breed       String?
  birthDate   DateTime?
  passedAt    DateTime?
  weightKg    Decimal?    @db.Decimal(5, 2)
  sizeBand    PetSizeBand
  color       String?
  photoUrl    String?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings Booking[]
  memorial Memorial?

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Service catalog
// ---------------------------------------------------------------------------

enum ServiceCategory {
  CREMATION_PRIVATE
  CREMATION_COMMUNAL
  BURIAL
  MEMORIAL
  GRIEF_COUNSELING
  ADD_ON
}

model Service {
  id            String          @id @default(cuid())
  slug          String          @unique
  category      ServiceCategory
  nameVi        String
  nameEn        String
  shortVi       String          @db.Text
  shortEn       String          @db.Text
  descriptionVi String          @db.Text
  descriptionEn String          @db.Text
  basePriceVnd  Int
  durationMin   Int             @default(120)
  isFeatured    Boolean         @default(false)
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tiers       ServiceTier[]
  bookings    BookingItem[]

  @@index([category, isActive])
}

// Price tiers for pet size (XS, S, M, L, XL)
model ServiceTier {
  id           String      @id @default(cuid())
  serviceId    String
  sizeBand     PetSizeBand
  priceVnd     Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, sizeBand])
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum BookingChannel {
  WEB
  PHONE
  PARTNER_CLINIC
}

model Booking {
  id              String         @id @default(cuid())
  code            String         @unique // BK-2026-000123
  customerId      String
  petId           String?
  status          BookingStatus  @default(DRAFT)
  channel         BookingChannel @default(WEB)

  // Pickup
  pickupRequired  Boolean        @default(true)
  pickupAddress   String?        @db.Text
  pickupCity      String?
  pickupDistrict  String?
  pickupLat       Decimal?       @db.Decimal(9, 6)
  pickupLng       Decimal?       @db.Decimal(9, 6)
  pickupWindow    DateTime?      // earliest pickup
  pickupWindowEnd DateTime?      // latest pickup

  // Ceremony / cremation slot
  scheduledFor    DateTime?
  livestream      Boolean        @default(false)
  livestreamUrl   String?

  // Grief
  griefCounseling Boolean        @default(false)

  // Finance
  subtotalVnd     Int            @default(0)
  discountVnd     Int            @default(0)
  taxVnd          Int            @default(0)
  totalVnd        Int            @default(0)

  notes           String?        @db.Text
  cancelReason    String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  confirmedAt     DateTime?
  completedAt     DateTime?

  customer  User           @relation(fields: [customerId], references: [id])
  pet       Pet?           @relation(fields: [petId], references: [id])
  items     BookingItem[]
  payments  Payment[]
  events    BookingEvent[]
  memorial  Memorial?

  @@index([status, scheduledFor])
  @@index([customerId])
}

model BookingItem {
  id         String  @id @default(cuid())
  bookingId  String
  serviceId  String
  quantity   Int     @default(1)
  unitPriceVnd Int
  totalVnd   Int

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
}

// Audit trail for booking lifecycle
model BookingEvent {
  id        String       @id @default(cuid())
  bookingId String
  type      String       // status_changed | payment_received | scheduled | ...
  payload   Json?
  actorId   String?
  createdAt DateTime     @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentProvider {
  STRIPE
  VNPAY
  MOMO
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

model Payment {
  id              String          @id @default(cuid())
  bookingId       String
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  amountVnd       Int
  providerRef     String?         @unique
  raw             Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  capturedAt      DateTime?
  refundedAt      DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Memorial wall (public tributes)
// ---------------------------------------------------------------------------

model Memorial {
  id          String   @id @default(cuid())
  slug        String   @unique
  bookingId   String?  @unique
  petId       String   @unique
  authorId    String
  title       String
  body        String   @db.Text
  isPublic    Boolean  @default(true)
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pet     Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])
  author  User     @relation(fields: [authorId], references: [id])
  tributes Tribute[]

  @@index([isPublic, createdAt])
}

model Tribute {
  id          String   @id @default(cuid())
  memorialId  String
  authorName  String
  message     String   @db.Text
  createdAt   DateTime @default(now())

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId, createdAt])
}

// ---------------------------------------------------------------------------
// Grief counseling
// ---------------------------------------------------------------------------

enum CounselingFormat {
  VIDEO
  PHONE
  IN_PERSON
}

model CounselingSession {
  id          String           @id @default(cuid())
  clientId    String
  counselorId String
  format      CounselingFormat @default(VIDEO)
  scheduledFor DateTime
  durationMin Int              @default(60)
  notes       String?          @db.Text
  cancelled   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client    User @relation("ClientOnSession", fields: [clientId], references: [id])
  counselor User @relation("CounselorOnSession", fields: [counselorId], references: [id])

  @@index([counselorId, scheduledFor])
}

// ---------------------------------------------------------------------------
// CMS-lite: testimonials and FAQ
// ---------------------------------------------------------------------------

model Testimonial {
  id        String   @id @default(cuid())
  authorName String
  petName   String
  bodyVi    String   @db.Text
  bodyEn    String?  @db.Text
  rating    Int      @default(5)
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  questionVi String  @db.Text
  questionEn String  @db.Text
  answerVi   String  @db.Text
  answerEn   String  @db.Text
  category   String  @default("general")
  sortOrder  Int     @default(0)
}
