# ---------------------------------------------------------------------------
# Pet Farewell VN — sample environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Pet Farewell"
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petfarewell?schema=public

# Auth (NextAuth v5)
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM="Pet Farewell <hello@pet-farewell.vn>"
EMAIL_REPLY_TO=support@pet-farewell.vn

# Payments — Stripe (international cards)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Payments — VNPay (domestic cards / QR / e-wallet)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/api/webhooks/vnpay

# Telephony (Vietnam SMS provider)
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID="PETFAREWELL"

# Storage (S3-compatible, e.g. R2 or VNG Cloud Object Storage)
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=pet-farewell-prod
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags
FEATURE_LIVESTREAM=true
FEATURE_GRIEF_COUNSELING=true
FEATURE_MEMORIAL_WALL=true
